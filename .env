HTTP_PORT=5005
HTTPS_PORT=8444

# Which Caddyfile the https-proxy uses.
#
# Caddyfile.selfsigned (default): issues a self-signed certificate on the fly for whatever
# hostname/IP you connect with. Good for LAN/Tailscale, no extra steps, browsers will warn
# once per device.
#
# Caddyfile.custom-cert: uses a certificate you already have (e.g. from Let's Encrypt or your
# router). Mount its files into the https-proxy service in compose.yml (uncomment the
# ./certs:/certs line), then set:
#   CADDYFILE=./Caddyfile.custom-cert
#   CERT_FILE=/certs/fullchain.pem
#   KEY_FILE=/certs/privkey.pem
CADDYFILE=./Caddyfile.selfsigned
CERT_FILE=
KEY_FILE=
